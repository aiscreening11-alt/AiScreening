        "description": "Retrieves real-time applicant stats across the pipeline (shortlisted, rejected, selected, review required)."
      }
    },
    {
      "name": "09 - Gmail Integration Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gmail/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gmail", "status"]
