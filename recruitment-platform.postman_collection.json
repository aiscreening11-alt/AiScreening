        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gmail/authorize",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gmail", "authorize"]
        },
        "description": "Opens Google OAuth consent screen directly in browser to link your recruitment Gmail account."
      }
    },
    {
      "name": "11 - Poll Gmail Inbox Now",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gmail/poll-now",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gmail", "poll-now"]
