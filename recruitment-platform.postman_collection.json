  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        },
        "description": "Verifies that the Spring Boot application and PostgreSQL database are UP and running."
      }
    },
    {
      "name": "02 - Create Job Opening",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('jobId', jsonData.data.id);",
              "    console.log('Saved jobId: ' + jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobTitle\": \"Senior Java Spring Boot Developer\",\n  \"department\": \"Engineering\",\n  \"description\": \"Building scalable microservices with Java 21, Spring Boot, and PostgreSQL\",\n  \"requiredSkills\": [\"Java\", \"Spring Boot\", \"PostgreSQL\", \"REST API\", \"Docker\"],\n  \"preferredSkills\": [\"Kubernetes\", \"AWS\", \"Kafka\"],\n  \"minimumExperience\": 4.0,\n  \"educationRequirement\": \"Bachelor in Computer Science\",\n  \"location\": \"Remote\",\n  \"employmentType\": \"FULL_TIME\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "jobs"]
        },
        "description": "Creates a job opening. Automatically sets the {{jobId}} collection variable from the response."
      }
    },
    {
      "name": "03 - List All Jobs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "jobs"]
        },
        "description": "Retrieves all active jobs posted in the platform."
      }
    },
    {
      "name": "04 - Upload Resume & Shoot Email (Screening)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('candidateId', jsonData.data.id);",
              "    console.log('Saved candidateId: ' + jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "description": "Select any PDF, DOCX, or TXT resume file"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/candidates/upload?jobId={{jobId}}&senderEmail=candidate@example.com",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "candidates", "upload"],
          "query": [
            {
              "key": "jobId",
              "value": "{{jobId}}"
            },
            {
              "key": "senderEmail",
              "value": "candidate@example.com"
            }
          ]
        },
        "description": "Uploads candidate resume, parses text with Apache Tika, runs ATS rule & AI scoring, assigns status (SHORTLISTED / REVIEW_REQUIRED / REJECTED), and shoots the automated email."
      }
    },
    {
      "name": "05 - View Candidate & Shooted Emails History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/candidates/{{candidateId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "candidates", "{{candidateId}}"]
        },
        "description": "Fetches candidate details, ATS score, extracted skills, and the full 'emailCommunications' history with rendered HTML bodies."
      }
    },
    {
      "name": "06 - Get ATS Score Breakdown",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/ats-result",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "candidates", "{{candidateId}}", "ats-result"]
        },
        "description": "Inspects the detailed ATS score breakdown (Skills 40%, Experience 20%, Education 10%, etc.)."
      }
    },
    {
      "name": "07 - Submit Interview Result & Shoot Final Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"result\": \"SELECTED\",\n  \"interviewerName\": \"Lead Architect\",\n  \"feedback\": \"Candidate demonstrated exceptional knowledge of Java 21, Spring Boot, and PostgreSQL clustering. Recommending for immediate offer.\",\n  \"interviewDate\": \"2026-10-09T10:00:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/candidates/{{candidateId}}/interview-result",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "candidates", "{{candidateId}}", "interview-result"]
        },
        "description": "Records Stage 2 technical interview result (SELECTED or NOT_SELECTED) and shoots the corresponding final Selection/Offer or Regret email."
      }
    },
    {
      "name": "08 - View Recruiter Dashboard Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/dashboard/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "dashboard", "metrics"]
